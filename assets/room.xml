<mujoco model="instruction_robot">
  <compiler angle="radian"/>
  <option timestep="0.002"/>
  <default><geom friction="1 0.005 0.0001"/><joint damping="0.1"/></default>
  <worldbody>
    <light pos="0 0 5"/>
    <geom name="floor" type="plane" size="4 4 0.1" rgba="0.75 0.75 0.75 1"/>
    <geom type="box" pos="0 4 0.3" size="4 0.05 0.3"/>
    <geom type="box" pos="0 -4 0.3" size="4 0.05 0.3"/>
    <geom type="box" pos="4 0 0.3" size="0.05 4 0.3"/>
    <geom type="box" pos="-4 0 0.3" size="0.05 4 0.3"/>
    <geom name="red_box" type="box" pos="2 0 0.25" size="0.25 0.25 0.25" rgba="1 0.05 0.05 1"/>
    <geom name="green_box" type="box" pos="1 2 0.25" size="0.25 0.25 0.25" rgba="0.05 1 0.05 1"/>
    <geom name="blue_ball" type="sphere" pos="1 -2 0.25" size="0.25" rgba="0.05 0.05 1 1"/>
    <body name="robot" pos="0 0 0.18">
      <freejoint/>
      <geom type="box" size="0.22 0.16 0.07" mass="2" rgba="0.2 0.2 0.25 1"/>
      <camera name="front" pos="0.23 0 0.12" xyaxes="0 -1 0 0 0 1" fovy="65"/>
      <body name="left_wheel" pos="0 0.19 -0.06">
        <joint name="left" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.12 0.035" quat="0.7071068 0.7071068 0 0" mass="0.2" rgba="0.1 0.1 0.1 1"/>
      </body>
      <body name="right_wheel" pos="0 -0.19 -0.06">
        <joint name="right" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.12 0.035" quat="0.7071068 0.7071068 0 0" mass="0.2" rgba="0.1 0.1 0.1 1"/>
      </body>
      <geom name="caster" type="sphere" pos="-0.18 0 -0.13" size="0.05" mass="0.05" friction="0.01 0.001 0.0001"/>
    </body>
  </worldbody>
  <actuator>
    <velocity name="left_motor" joint="left" kv="2" ctrllimited="true" ctrlrange="-10 10" forcelimited="true" forcerange="-2 2"/>
    <velocity name="right_motor" joint="right" kv="2" ctrllimited="true" ctrlrange="-10 10" forcelimited="true" forcerange="-2 2"/>
  </actuator>
</mujoco>
